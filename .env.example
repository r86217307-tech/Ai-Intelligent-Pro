# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_API_URL: The URL where the production Express server is hosted.
# Used on the client side (especially in production or Android environments) to point to the correct backend API.
VITE_API_URL="https://your-production-server-url.com"
APP_URL="https://your-production-server-url.com"
