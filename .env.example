# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Central API base URL system used by client-side/Android environments.
# Points to your production Express backend (e.g. your Cloud Run url).
VITE_API_BASE_URL="https://ais-pre-xx57rykxlx4qvpsbs45okj-627265381449.asia-southeast1.run.app"

# APP_URL / VITE_API_URL: Backups for client/server URLs
VITE_API_URL="https://ais-pre-xx57rykxlx4qvpsbs45okj-627265381449.asia-southeast1.run.app"
APP_URL="https://ais-pre-xx57rykxlx4qvpsbs45okj-627265381449.asia-southeast1.run.app"

